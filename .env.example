# Server
PORT=5000

# MongoDB (local MongoDB Community or an Atlas connection string)
MONGODB_URL=mongodb://127.0.0.1:27017/bugtrail

# JWT (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=30

# Web app origin: CORS allow-list and links in emails
CLIENT_URL=http://localhost:3000

# Refresh-token cookie
# Local dev (http): COOKIE_SECURE=false, COOKIE_SAME_SITE=lax
# Production on app.<domain> + api.<domain>: COOKIE_SECURE=true, COOKIE_SAME_SITE=lax
# Different sites (e.g. two *.up.railway.app URLs): COOKIE_SECURE=true, COOKIE_SAME_SITE=none
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Email. While false, emails are logged to the console instead of sent.
EMAIL_ENABLED=false
SMTP_HOST=email-server
SMTP_PORT=587
SMTP_USERNAME=email-server-username
SMTP_PASSWORD=email-server-password
EMAIL_FROM=support@yourapp.com

# First Admin, created by `npm run seed` (only if this email doesn't exist yet)
SEED_ADMIN_NAME=BugTrail Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-123
