# ==============================================================================
#  BugTrail API · environment variables
# ------------------------------------------------------------------------------
#  Copy to `.env`:  cp .env.example .env   (Command Prompt: copy .env.example .env)
#  Three sections: DEVELOPMENT (active), STAGING and PRODUCTION (commented out).
#  Only one section may be active: if a key appears twice, the later one silently
#  wins. Staging/production values go into Railway variables or the server's own
#  .env; they're kept here as a reference.
#  NODE_ENV comes from the npm scripts (dev/seed: development, start: production).
# ==============================================================================


# ##############################################################################
#  1. DEVELOPMENT · your machine (active)
#     Web http://localhost:3000 · API http://localhost:5000/v1
# ##############################################################################

# ─── Runtime ──────────────────────────────────────────────────────────────────
PORT=5000

# ─── Database ─────────────────────────────────────────────────────────────────
# Local MongoDB Community, or your own Atlas dev database. Never staging's or production's.
MONGODB_URL=mongodb://127.0.0.1:27017/bugtrail

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=dev-only-change-me
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=30

# ─── Web app (CORS, refresh/logout Origin check, links in emails) ─────────────
CLIENT_URL=http://localhost:3000

# ─── Email ────────────────────────────────────────────────────────────────────
# Sending is ON only when SMTP_HOST is set. Empty = emails are printed in the API
# console (with reset links), so you can work without SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=BugTrail <no-reply@localhost>

# ─── Local workaround (your machine only, never staging/production) ──────────
# If Atlas (mongodb+srv://) fails with `querySrv ECONNREFUSED`, set DNS_SERVERS=8.8.8.8.
DNS_SERVERS=


# ##############################################################################
#  2. STAGING · Railway, for testing (deploys from `development`)
#     Paste into the Railway API service → Variables (Raw Editor), without the "# ".
#     Railway sets PORT itself. Own database and JWT_SECRET, never production's.
# ##############################################################################

# NODE_ENV=production
# MONGODB_URL=${{MongoDB.MONGO_URL}}/bugtrail?authSource=admin
# JWT_SECRET=<long-random-string-for-staging>
# JWT_ACCESS_EXPIRATION_MINUTES=30
# JWT_REFRESH_EXPIRATION_DAYS=30
# CLIENT_URL=https://<staging-web-service>.up.railway.app
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM=BugTrail Staging <no-reply@yourdomain.com>
#
# • MONGODB_URL: the Railway MongoDB plugin's private URL plus a database name
#   (without a name, data lands in "test"), or a staging-only Atlas database.
# • CLIENT_URL: the staging web service's exact origin (https, no trailing slash),
#   or sign-in won't survive a page reload.
# • SMTP_HOST empty = emails only in the Railway logs. To test real email, use a
#   sandbox inbox (e.g. Mailtrap) so no real person gets emailed.
# • Not set: DNS_SERVERS. First Admin: `railway run npm run seed` from your machine.


# ##############################################################################
#  3. PRODUCTION · own VPS (deploys from `main`)
#     Copy into the server's .env (chmod 600), without the "# ".
#     PM2 runs one instance on PORT; Nginx proxies api.<domain> to it.
# ##############################################################################

# NODE_ENV=production
# PORT=5000
# MONGODB_URL=mongodb://bugtrail:<password>@127.0.0.1:27017/bugtrail?authSource=admin
# JWT_SECRET=<long-random-string-for-production>
# JWT_ACCESS_EXPIRATION_MINUTES=30
# JWT_REFRESH_EXPIRATION_DAYS=30
# CLIENT_URL=https://app.yourdomain.com
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_USERNAME=<smtp-username>
# SMTP_PASSWORD=<smtp-password>
# EMAIL_FROM=BugTrail <no-reply@yourdomain.com>
#
# • JWT_SECRET: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# • MONGODB_URL: MongoDB on the box (auth on, bound to 127.0.0.1) or a production Atlas cluster.
# • Not set: DNS_SERVERS. First Admin: `npm run seed` in an SSH session on the server.
